# ── Dynatrace ────────────────────────────────────────────────────────────────
# Your Dynatrace OTLP endpoint, e.g. https://abc12345.live.dynatrace.com
DT_ENDPOINT=

# API token with these ingest scopes:
#   openTelemetryTrace.ingest, metrics.ingest, logs.ingest
DT_API_TOKEN=

# Optional — labels every span with deployment.environment
DEPLOYMENT_ENV=dev

# ── vixcode agent (these go to the Python process, not docker) ──────────────
# Tell the agent to emit telemetry:
#   VIXCODE_OTEL_ENABLED=true
#   VIXCODE_OTEL_ENDPOINT=http://localhost:4318
#   VIXCODE_OTEL_SERVICE_NAME=vixcode-agent
#   VIXCODE_OTEL_CONSOLE=true     # also dump spans to stdout (dev only)
